<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app theme: only the window shows through before Compose draws, so it carries the canvas color. -->
    <style name="Theme.Rei" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/rei_canvas</item>
        <item name="android:colorBackground">@color/rei_canvas</item>
    </style>

    <!-- Launch theme: the splash screen on the canvas color with Rei's portrait, then Theme.Rei. -->
    <style name="Theme.Rei.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rei_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Rei</item>
    </style>
</resources>
