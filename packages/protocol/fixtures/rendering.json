{
  "$comment": "Rei rendering conformance fixtures (docs/rendering.md). Each case: input Markdown -> expected structure.",
  "version": 1,
  "markdown": [
    {
      "name": "heading-and-paragraph",
      "input": "# Title\n\nA paragraph\nwith a line break.",
      "expected": [
        {
          "t": "h",
          "level": 1,
          "slug": "title",
          "children": [
            {
              "t": "text",
              "text": "Title"
            }
          ]
        },
        {
          "t": "p",
          "children": [
            {
              "t": "text",
              "text": "A paragraph"
            },
            {
              "t": "br"
            },
            {
              "t": "text",
              "text": "with a line break."
            }
          ]
        }
      ]
    },
    {
      "name": "emphasis",
      "input": "**bold**, *em*, ***both***, ~~gone~~ and `code`; snake_case_name stays text.",
      "expected": [
        {
          "t": "p",
          "children": [
            {
              "t": "strong",
              "children": [
                {
                  "t": "text",
                  "text": "bold"
                }
              ]
            },
            {
              "t": "text",
              "text": ", "
            },
            {
              "t": "em",
              "children": [
                {
                  "t": "text",
                  "text": "em"
                }
              ]
            },
            {
              "t": "text",
              "text": ", "
            },
            {
              "t": "strong",
              "children": [
                {
                  "t": "em",
                  "children": [
                    {
                      "t": "text",
                      "text": "both"
                    }
                  ]
                }
              ]
            },
            {
              "t": "text",
              "text": ", "
            },
            {
              "t": "del",
              "children": [
                {
                  "t": "text",
                  "text": "gone"
                }
              ]
            },
            {
              "t": "text",
              "text": " and "
            },
            {
              "t": "code",
              "text": "code"
            },
            {
              "t": "text",
              "text": "; snake_case_name stays text."
            }
          ]
        }
      ]
    },
    {
      "name": "escapes",
      "input": "\\*not em\\* and \\`not code\\`",
      "expected": [
        {
          "t": "p",
          "children": [
            {
              "t": "text",
              "text": "*not em* and `not code`"
            }
          ]
        }
      ]
    },
    {
      "name": "links",
      "input": "[site](https://example.com), <mailto> [mail](mailto:a@b.c), bare https://example.com/path. and [js](javascript:alert(1))",
      "expected": [
        {
          "t": "p",
          "children": [
            {
              "t": "link",
              "href": "https://example.com",
              "children": [
                {
                  "t": "text",
                  "text": "site"
                }
              ]
            },
            {
              "t": "text",
              "text": ", <mailto> "
            },
            {
              "t": "link",
              "href": "mailto:a@b.c",
              "children": [
                {
                  "t": "text",
                  "text": "mail"
                }
              ]
            },
            {
              "t": "text",
              "text": ", bare "
            },
            {
              "t": "link",
              "href": "https://example.com/path",
              "children": [
                {
                  "t": "text",
                  "text": "https://example.com/path"
                }
              ]
            },
            {
              "t": "text",
              "text": ". and "
            },
            {
              "t": "text",
              "text": "js"
            }
          ]
        }
      ]
    },
