# sshd running as the unprivileged user "agent" (uid 1000): no root, no capabilities, nothing to drop privileges to.
Port 2222
ListenAddress 0.0.0.0
# Host key and authorized_keys live in the exec-host volume (mounted read-only), written by the exec-keys service.
HostKey /etc/exec-keys/ssh_host_ed25519_key
AuthorizedKeysFile /etc/exec-keys/authorized_keys
PidFile none
UsePAM no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthenticationMethods publickey
PermitRootLogin no
AllowUsers agent
PermitEmptyPasswords no
# The control plane only runs commands. Nothing may tunnel out of, or into, the sandbox over this connection.
AllowTcpForwarding no
AllowStreamLocalForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no
PermitUserEnvironment no
PrintMotd no
ClientAliveInterval 15
ClientAliveCountMax 3
MaxStartups 20:30:60
LogLevel INFO
